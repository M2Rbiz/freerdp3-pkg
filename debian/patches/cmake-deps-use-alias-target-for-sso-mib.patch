diff --git a/cmake/Findsso-mib.cmake b/cmake/Findsso-mib.cmake
new file mode 100644
index 000000000..768174e60
--- /dev/null
+++ b/cmake/Findsso-mib.cmake
@@ -0,0 +1,10 @@
+# - Find sso-mib
+# Find the sso-mib library
+
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright 2025 Siemens
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(PC_SSO_MIB sso-mib>=0.5.0 REQUIRED IMPORTED_TARGET)
+
+add_library(sso-mib ALIAS PkgConfig::PC_SSO_MIB)
